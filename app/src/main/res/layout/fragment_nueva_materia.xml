<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_auto_stories"
                app:tint="@color/primary"
                android:background="@drawable/bg_pill_surface"
                android:padding="12dp"/>
                
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agregar Asignatura"
                    android:textColor="@color/on_surface"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configura los datos básicos"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Form container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_surface"
            android:padding="16dp">
            
            <!-- Nombre input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de la Asignatura"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"/>
            <EditText
                android:id="@+id/et_nombre_asignatura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/subject_name_hint"
                android:background="@drawable/bg_pill_surface"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:inputType="textCapWords"
                android:textColor="@color/on_surface" />

            <!-- Color picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color identificador del ramo"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:layout_marginTop="24dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_surface"
                android:padding="12dp"
                android:gravity="center">

                <!-- Color 1: Azul Primario (ID 1) -->
                <FrameLayout
                    android:id="@+id/layout_color_1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_circle_primary"
                    android:backgroundTint="@color/primary"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/iv_check_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_check"
                        android:padding="8dp"
                        app:tint="@color/on_primary"
                        android:visibility="visible" />
                </FrameLayout>

                <!-- Color 2: Índigo (ID 2) -->
                <FrameLayout
                    android:id="@+id/layout_color_2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_circle_primary"
                    android:backgroundTint="@color/primary_container"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/iv_check_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_check"
                        android:padding="8dp"
                        app:tint="@color/on_primary"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Color 3: Verde Esmeralda (ID 3) -->
                <FrameLayout
                    android:id="@+id/layout_color_3"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_circle_primary"
                    android:backgroundTint="@color/tertiary"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/iv_check_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_check"
                        android:padding="8dp"
                        app:tint="@color/on_primary"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Color 4: Cian Santo (ID 4) -->
                <FrameLayout
                    android:id="@+id/layout_color_4"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_circle_primary"
                    android:backgroundTint="@color/secondary"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/iv_check_4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_check"
                        android:padding="8dp"
                        app:tint="@color/on_primary"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Color 5: Rojo Carmesí (ID 5) -->
                <FrameLayout
                    android:id="@+id/layout_color_5"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_circle_primary"
                    android:backgroundTint="@color/error"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/iv_check_5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_check"
                        android:padding="8dp"
                        app:tint="@color/on_primary"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons -->
        <Button
            android:id="@+id/btn_guardar_asignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Guardar Asignatura"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            android:enabled="false"
            android:padding="12dp"/>
        <Button
            android:id="@+id/btn_cancelar_asignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancelar"
            android:backgroundTint="@color/surface_container"
            android:textColor="@color/on_surface_variant"
            android:padding="12dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
