<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="80dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_auto_stories"
                app:tint="@color/primary"
                android:background="@drawable/bg_pill_surface"
                android:padding="12dp"/>
                
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agregar Asignatura"
                    android:textColor="@color/on_surface"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configura los datos básicos"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Form container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_surface"
            android:padding="16dp">
            
            <!-- Nombre input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de la Asignatura"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"/>
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. Cálculo II"
                android:background="@drawable/bg_pill_surface"
                android:padding="12dp"
                android:layout_marginTop="8dp"/>

            <!-- Color picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color identificador del ramo"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:layout_marginTop="24dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill_surface"
                android:padding="12dp"
                android:gravity="center">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_check"
                    android:padding="8dp"
                    app:tint="@color/on_primary"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_circle_primary"/>
                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_circle_primary"
                    android:backgroundTint="@color/primary_container"/>
                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_circle_primary"
                    android:backgroundTint="@color/tertiary"/>
                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_circle_primary"
                    android:backgroundTint="@color/secondary"/>
                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_circle_primary"
                    android:backgroundTint="@color/error"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Guardar Asignatura"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"
            android:padding="12dp"/>
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancelar"
            android:backgroundTint="@color/surface_container"
            android:textColor="@color/on_surface_variant"
            android:padding="12dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
